{
  "name": "divessi-client",
  "version": "0.1.0",
  "description": "Unofficial, portable TypeScript client for the SSI / DiveSSI app API",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "vp env install && vp install --frozen-lockfile",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "check": "pnpm run build && vp check .",
    "test": "pnpm run build && node --test test/*.test.mjs && pnpm run test:types",
    "test:bun": "bun test test/client.test.mjs",
    "test:types": "tsc -p test/tsconfig.json && tsc -p test/tsconfig.portable.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.15.0"
}
