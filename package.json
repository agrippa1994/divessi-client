{
  "name": "divessi-client",
  "version": "0.1.0",
  "description": "Unofficial, portable TypeScript client for the SSI / DiveSSI app API",
  "homepage": "https://github.com/agrippa1994/divessi-client#readme",
  "bugs": "https://github.com/agrippa1994/divessi-client/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrippa1994/divessi-client.git"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "FIELD-GUIDE.md",
    "CHANGELOG.md",
    "examples",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "setup": "vp env install && vp install --frozen-lockfile",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "example:read": "pnpm run build && node examples/read-dives.ts",
    "example:create": "pnpm run build && node examples/create-dive.ts",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "check": "pnpm run build && vp check .",
    "test": "pnpm run build && node --test test/*.test.mjs && pnpm run test:types",
    "test:bun": "bun test test/client.test.mjs",
    "test:types": "tsc -p test/tsconfig.json && tsc -p test/tsconfig.portable.json && tsc -p examples/tsconfig.json",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.15.0"
}
